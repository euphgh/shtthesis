.vscode/*
.DS_Store/
_minted*/
!.vscode/settings.json

# ignore latexmk temporary files
*.gz
*.zip
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.toc
*.xdv
*.xml
*-converted-to.pdf
*.thm
*.lof
*.bcf
build*/
release*/

# ignore compiled docuemnt within root
*.pdf
!shanghaitech-emblem.pdf
!shtthesis-user-guide.pdf
!resource/*.pdf

# ignore office temp files
~$*.doc*
~$*.ppt*
~$*.pdf

# ignore font files
*.TTF
*.otf
Fonts/COPYING-Fandol.txt
Fonts/LICENSE-Source.txt

# ignore data archeaves
*.npz
*.pth

# ignore duplicated files
* [2-9].*

# ignore Python import caches from presentation scripts
__pycache__/

# Presentation deliverables: track only the current red final deck.
*.pptx
!/pptx/midterm/REMUS_Midterm_Final.pptx
/pptx/**/*.manifest.json
/figure/presentation-preview/
/figure/presentation-reference/
/figure/ppt-assets/navy-teal/

# Editable frontmatter source is unpacked OpenXML, not a generated PPTX.
!/scripts/midterm_pptx/frontmatter/**/*.xml
!/scripts/midterm_pptx/frontmatter/[[]Content_Types].xml
